# Alpha–Beta Pruning in Python

import math

# Minimax function with Alpha-Beta Pruning
def minimax(depth, node_index, maximizing_player, values, alpha, beta, max_depth):
    # Base case: leaf node reached
    if depth == max_depth:
        return values[node_index]

    if maximizing_player:
        best = -math.inf

        # Traverse left and right children
        for i in range(2):
            val = minimax(depth + 1, node_index * 2 + i, False, values, alpha, beta, max_depth)
            best = max(best, val)
            alpha = max(alpha, best)

            # Alpha Beta Pruning
            if beta <= alpha:
                break

        return best

    else:
        best = math.inf

        # Traverse left and right children
        for i in range(2):
            val = minimax(depth + 1, node_index * 2 + i, True, values, alpha, beta, max_depth)
            best = min(best, val)
            beta = min(beta, best)

            # Alpha Beta Pruning
            if beta <= alpha:
                break

        return best


# Example usage
if __name__ == "__main__":
    # Example game tree (depth = 3)
    values = [3, 5, 6, 9, 1, 2, 0, -1]
    print(values)
    max_depth = 3
    result = minimax(0, 0, True, values, -math.inf, math.inf, max_depth)
    print("The optimal value is:", result)
